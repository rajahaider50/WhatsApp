<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WhatsApp" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/whatsapp_dark_surface</item>
        <item name="android:navigationBarColor">@color/whatsapp_dark_surface</item>
        <item name="android:windowBackground">@color/whatsapp_dark_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.WhatsApp.FullscreenCall" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/whatsapp_incoming_call_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
